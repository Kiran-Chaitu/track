{
  "name": "roll-number-scanner-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API that stores unique student registration numbers in a JSON file",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
