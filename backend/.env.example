# Copy to .env for local development (`npm run dev` loads it automatically).
# On Render, set these in the dashboard / render.yaml instead. Never commit .env.

NODE_ENV=development
PORT=3000
# HOST=0.0.0.0

# Where registration numbers are stored. Defaults to ./data/roll_numbers.json
# in development. REQUIRED in production and must be on a persistent disk,
# e.g. /var/data/roll_numbers.json on Render.
# DATA_FILE_PATH=./data/roll_numbers.json
# DATA_DIR=./data

# Accepted format AFTER trimming and upper-casing. Always matched against the
# whole value. Keep in sync with the app's REG_PATTERN.
ROLL_NUMBER_PATTERN=^[A-Z0-9]{4,20}$
# ROLL_NUMBER_MAX_LENGTH=64

# Bearer token for GET /api/roll-numbers and /api/roll-numbers/count.
# Leave empty to disable those endpoints. Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Optional shared key the app sends as X-Api-Key. It ships inside the app and
# can be extracted, so treat it as a speed bump, not real authentication.
INGEST_API_KEY=

# Set to 1 behind exactly one reverse proxy (Render), so rate limiting sees
# real client IPs. Leave unset locally.
# TRUST_PROXY=1

# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_WRITE_MAX=300
# RATE_LIMIT_ADMIN_MAX=30
# REQUEST_TIMEOUT_MS=10000
# BODY_LIMIT=1kb
# LOG_LEVEL=info
